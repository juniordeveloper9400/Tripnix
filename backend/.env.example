# Cloudflare R2 — S3 endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=56ed8ed6ebe87f4ddc538a42469da2cc
R2_BUCKET=tripnix
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Set once the bucket's public access is enabled, e.g.
# https://pub-xxxxxxxx.r2.dev  — leave blank and the API serves files itself.
R2_PUBLIC_URL=

# Firebase — ALL FOUR are required. Without the service account pair below,
# the API silently runs on an in-memory store: registrations are never saved
# and sign-in fails. Check GET /api/auth/health to see what is missing.

# Project settings -> General
FIREBASE_PROJECT_ID=tripnix-cfe2b
# Project settings -> General -> Web API Key. Needed to verify passwords.
FIREBASE_WEB_API_KEY=

# Build -> Realtime Database. Must be the exact instance URL including region —
# outside us-central1 it is NOT https://<project>.firebaseio.com, and a wrong
# value fails every read.
FIREBASE_DATABASE_URL=https://tripnix-cfe2b-default-rtdb.asia-southeast1.firebasedatabase.app

# Project settings -> Service accounts -> Generate new private key.
# Either drop that JSON in backend/serviceAccountKey.json and leave these two
# blank, or copy the two fields out of it. Keep the quotes and the literal
# \n escapes in the private key.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tripnix-cfe2b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Google Maps — optional. With it the GPS view in the admin and owner portals
# shows a real Google map; without it they draw a stand-in so the view still
# works. Create a browser key at Google Cloud -> APIs & Services -> Credentials,
# enable "Maps JavaScript API", and restrict it by HTTP referrer to your own
# domains. Browser keys are public by design — the referrer restriction is the
# protection, not secrecy.
GOOGLE_MAPS_API_KEY=
