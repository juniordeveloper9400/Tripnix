node_modules/
**/node_modules/
.vercel
.flutter/
dist/
admin/dist/
build/
.env
.env.*
!.env.example

# Firebase service account private key — never commit.
# Globbed loosely on purpose: a "Save As" on Windows easily produces
# serviceAccountKey.json.json or serviceAccountKey (1).json.
**/serviceAccountKey*
**/*serviceaccount*.json
**/firebase-adminsdk-*.json

.DS_Store
*.log

# Appended by `vercel link`. .vercel and .env* are already covered above, and a
# bare `.env*` here would override the `!.env.example` negation, so the example
# file stays listed explicitly.
.env.local
!**/.env.example
